# Fejlesztéskor állítsd true-ra, ha szükség van a lebegő demóvezérlőre.
VITE_ENABLE_DEMO_UI=false

# Marketingmérés — csak production buildben töltődik be. Üresen hagyva az
# adott script/konverzió egyszerűen nem indul el, nincs hiba.
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LABEL_LEAD_SUBMIT=
VITE_GOOGLE_ADS_LABEL_CALLBACK_SUBMIT=
VITE_GOOGLE_ADS_LABEL_QUOTE_REQUEST_SUBMIT=
VITE_GOOGLE_ADS_LABEL_PHONE_CLICK=
VITE_META_PIXEL_ID=

# Search Console domain-verifikáció (meta tag módszer). DNS TXT rekordos
# verifikációhoz nincs szükség erre — az teljesen a Cloudflare DNS-ben történik.
VITE_GOOGLE_SITE_VERIFICATION=
